{
  "name": "landlord",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm --filter @landlord/server dev\" \"pnpm --filter @landlord/web dev\"",
    "build": "pnpm --filter @landlord/web build && pnpm --filter @landlord/server build",
    "test": "pnpm -r test && node --test \"scripts/*.test.mjs\"",
    "typecheck": "pnpm -r typecheck",
    "e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "format": "prettier --write .",
    "start": "node apps/server/dist/index.js"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
